# Every variable here is read on the server only (never exposed to the browser)
# and only NEAR testnet is supported: the RPC host must contain "testnet".
# Copy to .env.local (not committed) to read a mandate from the chain.

# JSON-RPC endpoint for view calls. Default: https://rpc.testnet.fastnear.com
SCRIP_RPC_URL=https://rpc.testnet.fastnear.com

# Testnet account id of the deployed scrip contract. Leave unset to show sample data.
SCRIP_CONTRACT_ID=

# Optional hosted relayer for /api/relay (gasless request_payment). Server only.
# Never commit real values; on Vercel store the key as a sensitive variable.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
